PORT=8080
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_TOPIC=lowveld-grove/zone04/telemetry
SIMULATE_ON_BOOT=true

MOISTURE_THRESHOLD=28
PUMP_MOISTURE_THRESHOLD=18
CRITICAL_MOISTURE=12
CRITICAL_TEMP=36
TREND_WINDOW_MS=600000

# OpenWeatherMap (free tier) — get a key at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_api_key
WEATHER_LAT=-25.4547
WEATHER_LON=30.9694
WEATHER_POLL_INTERVAL_MS=600000

# Supabase — Project Settings -> API in your Supabase dashboard.
# Run sql/001_zone_telemetry.sql in the SQL Editor once before this works.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_publishable_or_secret_key
SUPABASE_LOG_INTERVAL_MS=30000
